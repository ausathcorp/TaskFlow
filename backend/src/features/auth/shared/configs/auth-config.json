    "limiter": {
      "window_ms": 300,
      "limit": 5
    }
  },
  "forgot_password": {
    "state": "running",
    "limiter": {
      "window_ms": 60,
      "limit": 5
    }
  },
  "reset_password": {
    "state": "running",
